          <mxGeometry x="100" y="855" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- ═══════════════ ROUTE NAVIGATION (right column, centre x=1000) ═══════════════ -->

        <mxCell id="20" value="&#x1F5FA;&#xFE0F; Route Navigation" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;">
          <mxGeometry x="900" y="290" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="21" value="Set Destination" parent="1" vertex="1"
