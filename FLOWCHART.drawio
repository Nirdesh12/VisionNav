      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════════════════════ APP ENTRY ═══════════════════════ -->

        <mxCell id="2" value="&#x1F4F1; App Launch" parent="1" vertex="1"
