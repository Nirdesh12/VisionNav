          <mxGeometry x="1050" y="860" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="28" value="Arrived?" parent="1" vertex="1"
          style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry x="895" y="955" width="210" height="80" as="geometry" />
        </mxCell>

        <mxCell id="29" value="&#x1F389; You Have Arrived" parent="1" vertex="1"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;">
          <mxGeometry x="900" y="1075" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════ EDGES ══════════════════════════ -->

        <!-- App Launch → Home Screen -->
        <mxCell id="100" edge="1" source="2" target="3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Home Screen → Object Detection -->
        <mxCell id="101" value="Object Detection" edge="1" source="3" target="10" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="250" />
              <mxPoint x="200" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Home Screen → Route Navigation -->
        <mxCell id="102" value="Navigation" edge="1" source="3" target="20" parent="1">
