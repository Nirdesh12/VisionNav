<?xml version="1.0" encoding="UTF-8"?>
<mxfile version="21.0.0">
  <diagram name="VisionNav Flowchart" id="visionnav-flowchart">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1" page="1"
                  pageScale="1" pageWidth="1200" pageHeight="1800"
                  math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ── APP ENTRY ── -->

        <mxCell id="2" value="App Launch" parent="1" vertex="1"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;">
          <mxGeometry x="450" y="40" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="3" value="Home Screen" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;">
          <mxGeometry x="450" y="140" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- ── OBJECT DETECTION (left column, centre x=220) ── -->

        <mxCell id="10" value="Object Detection" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;">
          <mxGeometry x="100" y="260" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="11" value="Start Camera + LiDAR" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;">
          <mxGeometry x="100" y="350" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="12" value="Capture Frame" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;">
          <mxGeometry x="100" y="440" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="13" value="Run YOLOv8 Model" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;">
          <mxGeometry x="100" y="530" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="14" value="Object Detected?" parent="1" vertex="1"
          style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry x="95" y="615" width="210" height="75" as="geometry" />
        </mxCell>

        <mxCell id="15" value="Get Depth (LiDAR)" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;">
          <mxGeometry x="100" y="730" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="16" value="Voice + Haptic Alert" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;">
          <mxGeometry x="100" y="820" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- ── ROUTE NAVIGATION (right column, centre x=760) ── -->

        <mxCell id="20" value="Route Navigation" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;">
          <mxGeometry x="680" y="260" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="21" value="Set Destination" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;">
          <mxGeometry x="680" y="350" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="22" value="Fetch Route (OSRM)" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;">
          <mxGeometry x="680" y="440" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="23" value="Start Navigation Loop" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;">
          <mxGeometry x="680" y="530" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="24" value="Detect Obstacles" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;">
          <mxGeometry x="680" y="620" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="25" value="Obstacle Ahead?" parent="1" vertex="1"
          style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry x="675" y="705" width="210" height="75" as="geometry" />
        </mxCell>

        <mxCell id="26" value="Warn User (Voice + Haptic)" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;">
          <mxGeometry x="560" y="820" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="27" value="Give Next Turn Instruction" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;">
          <mxGeometry x="800" y="820" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="28" value="Arrived?" parent="1" vertex="1"
          style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry x="675" y="910" width="210" height="75" as="geometry" />
        </mxCell>

        <mxCell id="29" value="Announce Arrival" parent="1" vertex="1"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;">
          <mxGeometry x="680" y="1025" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- ══════════════════ EDGES ══════════════════ -->

        <!-- App entry -->
        <mxCell id="100" edge="1" source="2" target="3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Home → Object Detection -->
        <mxCell id="101" edge="1" source="3" target="10" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="220" />
              <mxPoint x="200" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Home → Route Navigation -->
        <mxCell id="102" edge="1" source="3" target="20" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="220" />
              <mxPoint x="780" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Object Detection chain -->
        <mxCell id="110" edge="1" source="10" target="11" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="111" edge="1" source="11" target="12" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="112" edge="1" source="12" target="13" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="113" edge="1" source="13" target="14" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- No → loop back to Capture Frame -->
        <mxCell id="114" value="No" edge="1" source="14" target="12" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="652" />
              <mxPoint x="40" y="465" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Yes → Get Depth -->
        <mxCell id="115" value="Yes" edge="1" source="14" target="15" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="116" edge="1" source="15" target="16" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Alert → loop back to Capture Frame -->
        <mxCell id="117" edge="1" source="16" target="12" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="845" />
              <mxPoint x="40" y="465" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Route Navigation chain -->
        <mxCell id="120" edge="1" source="20" target="21" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="121" edge="1" source="21" target="22" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="122" edge="1" source="22" target="23" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="123" edge="1" source="23" target="24" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="124" edge="1" source="24" target="25" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Obstacle Yes → Warn -->
        <mxCell id="125" value="Yes" edge="1" source="25" target="26" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Obstacle No → Next Turn -->
        <mxCell id="126" value="No" edge="1" source="25" target="27" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Warn → Arrived? -->
        <mxCell id="127" edge="1" source="26" target="28" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Next Turn → Arrived? -->
        <mxCell id="128" edge="1" source="27" target="28" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrived Yes → Announce -->
        <mxCell id="129" value="Yes" edge="1" source="28" target="29" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrived No → loop back to Navigation Loop -->
        <mxCell id="130" value="No" edge="1" source="28" target="23" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="947" />
              <mxPoint x="940" y="555" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
