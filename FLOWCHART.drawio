          <mxGeometry x="900" y="560" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="24" value="Detect Obstacles" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;">
          <mxGeometry x="900" y="650" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="25" value="Obstacle&#xa;Ahead?" parent="1" vertex="1"
