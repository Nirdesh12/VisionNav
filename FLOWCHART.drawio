            <Array as="points">
              <mxPoint x="650" y="250" />
              <mxPoint x="1000" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Object Detection chain -->
        <mxCell id="110" edge="1" source="10" target="11" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="111" edge="1" source="11" target="12" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="112" edge="1" source="12" target="13" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="113" edge="1" source="13" target="14" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Object Detected? No → loop to Capture Frame -->
        <mxCell id="114" value="No" edge="1" source="14" target="12" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="30" y="685" />
              <mxPoint x="30" y="495" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Object Detected? Yes → Get Depth -->
        <mxCell id="115" value="Yes" edge="1" source="14" target="15" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="116" edge="1" source="15" target="16" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Alert → loop back to Capture Frame -->
        <mxCell id="117" edge="1" source="16" target="12" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="30" y="880" />
              <mxPoint x="30" y="495" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Route Navigation chain -->
        <mxCell id="120" edge="1" source="20" target="21" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="121" edge="1" source="21" target="22" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="122" edge="1" source="22" target="23" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="123" edge="1" source="23" target="24" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="124" edge="1" source="24" target="25" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Obstacle? Yes → Warn -->
        <mxCell id="125" value="Yes" edge="1" source="25" target="26" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Obstacle? No → Next Turn -->
        <mxCell id="126" value="No" edge="1" source="25" target="27" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Warn → Arrived? -->
        <mxCell id="127" edge="1" source="26" target="28" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Next Turn → Arrived? -->
        <mxCell id="128" edge="1" source="27" target="28" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrived? Yes → Announce Arrival -->
        <mxCell id="129" value="Yes" edge="1" source="28" target="29" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrived? No → loop back to Navigation Loop -->
        <mxCell id="130" value="No" edge="1" source="28" target="23" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1165" y="995" />
              <mxPoint x="1165" y="585" />
            </Array>
          </mxGeometry>
